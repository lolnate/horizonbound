APP_BASE_URL=http://127.0.0.1:3000
HOST=127.0.0.1
PORT=3000
HORIZONBOUND_STATE_DIR=~/.local/state/horizonbound
# Preferred for a single-user local installation. Create a read-only personal key in Linear.
# If both credential modes are configured, LINEAR_API_KEY takes precedence.
LINEAR_API_KEY=
# OAuth remains available for deployments that register an application.
# Generate 32 random bytes and encode them as base64 before enabling OAuth tokens.
TOKEN_ENCRYPTION_KEY=
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=
